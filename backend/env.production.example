# Пример боевых настроек. Скопируйте в env.production (или .env) на СЕРВЕРЕ
# и подставьте настоящие значения. Этот файл в репозиторий не попадает.
NODE_ENV=production
PORT=3000

DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USER=plantakt
DATABASE_PASSWORD=<СГЕНЕРИРУЙТЕ_ДЛИННЫЙ_ПАРОЛЬ>
DATABASE_NAME=school_tasks

# Ключ первичной установки супер-админа: минимум 32 символа.
# Сгенерировать: openssl rand -hex 32
SUPER_ADMIN_SETUP_KEY=<СГЕНЕРИРУЙТЕ_КЛЮЧ>

FRONTEND_URL=https://plantakt.ru
